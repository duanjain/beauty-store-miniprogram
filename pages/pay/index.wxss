page {
  background-color: #f7f8fa;
  padding-bottom: 120rpx;
}

.container {
  padding: 30rpx;
}

.section-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.02);
}

/* Address Card */
.address-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 100rpx;
}

.card-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.icon-location {
  font-size: 40rpx;
  margin-right: 20rpx;
  color: #333;
}

.address-info {
  display: flex;
  flex-direction: column;
}

.user-info {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.user-info .phone {
  margin-left: 20rpx;
  font-weight: normal;
  color: #666;
  font-size: 26rpx;
}

.address-detail {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

.address-placeholder {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.card-right {
  margin-left: 20rpx;
}

.arrow {
  color: #ccc;
  font-size: 32rpx;
}

/* Order Card */
.order-card {
  padding: 40rpx;
}

.card-header {
  text-align: center;
  margin-bottom: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  padding-bottom: 20rpx;
}

.title {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.card-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.amount-box {
  margin-bottom: 40rpx;
  display: flex;
  align-items: baseline;
}

.currency {
  font-size: 36rpx;
  color: #333;
  font-weight: 600;
  margin-right: 4rpx;
}

.amount {
  font-size: 64rpx;
  color: #333;
  font-weight: bold;
}

.info-list {
  width: 100%;
}

.info-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.label {
  color: #666;
}

.value {
  color: #333;
  font-weight: 500;
  text-align: right;
  max-width: 70%;
}

.sub-value {
  color: #999;
  font-size: 24rpx;
  margin-left: auto;
}

/* Points Card */
.points-card {
  display: flex;
  flex-direction: column;
}

.points-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.points-info {
  display: flex;
  flex-direction: column;
}

.sub-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.points-deduction {
  margin-top: 20rpx;
  text-align: right;
  border-top: 1rpx solid #f5f5f5;
  padding-top: 20rpx;
}

.points-input-area {
  margin-top: 20rpx;
  background: #f9f9f9;
  padding: 20rpx;
  border-radius: 8rpx;
}

.input-row {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.points-input {
  flex: 1;
  background: #fff;
  margin: 0 16rpx;
  height: 64rpx;
  border-radius: 4rpx;
  border: 1rpx solid #e0e0e0;
  text-align: center;
  font-size: 30rpx;
}

.tip {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.deduction-text {
  color: #ff4d4f;
  font-weight: 500;
}


/* Action Area */
.action-area {
  padding: 0 20rpx;
  margin-top: 40rpx;
}

.btn-pay {
  background: #07c160;
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  height: 96rpx;
  line-height: 96rpx;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.3);
}

.btn-pay[disabled] {
  background: #a0eac4 !important;
  color: #fff !important;
}
