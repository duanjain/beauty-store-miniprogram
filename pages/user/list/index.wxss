.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 顶部导航栏样式 - 与其他管理页面保持一致 */
.top-nav {
  display: flex;
  justify-content: space-between;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  padding: 12rpx;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 16rpx;
  border-radius: 12rpx;
  transition: all 0.3s ease;
  position: relative;
  background: transparent;
}

.nav-item:hover {
  background: rgba(255, 255, 255, 0.1);
  transform: translateY(-2rpx);
}

.nav-item.active {
  background: white;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.nav-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.nav-text {
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

/* 默认（未激活）状态下的文字颜色 */
.nav-item:not(.active) .nav-text {
  color: rgba(255, 255, 255, 0.9);
}

/* 激活状态下的文字颜色 */
.nav-item.active .nav-text {
  color: #667eea;
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.search-section {
  display: flex;
  margin-bottom: 30rpx;
  overflow: hidden;
}

.search-input {
  flex: 1;
  height: 92rpx;
  border: none;
  border-radius: 16rpx 0 0 16rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
  margin-right: 0;
  background-color: transparent;
  outline: none;
}

.search-btn {
  font-size: 30rpx;
  font-weight: 600;
  padding: 0 48rpx;
  height: 92rpx;
  line-height: 92rpx;
}

.user-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.user-item {
  padding: 24rpx;
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 28rpx;
  background-color: #f0f0f0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.user-avatar image {
  width: 100%;
  height: 100%;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.user-phone {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.user-register {
  font-size: 26rpx;
  color: #999;
}

.empty {
  text-align: center;
  padding: 150rpx 0;
  color: #999;
  font-size: 32rpx;
}

.loading {
  text-align: center;
  padding: 50rpx 0;
  color: #999;
  font-size: 30rpx;
}

/* 积分输入对话框样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  background-color: white;
  border-radius: 20rpx;
  width: 600rpx;
  max-width: 90%;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  cursor: pointer;
  padding: 0 10rpx;
}

.modal-body {
  padding: 30rpx;
}

.input-info {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.info-label {
  font-size: 30rpx;
  color: #666;
  width: 180rpx;
}

.info-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
}

.points-input {
  flex: 1;
  height: 80rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  outline: none;
}

.points-input:focus {
  border-color: #667eea;
}

.input-hint {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
  display: block;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}

.modal-btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  border: none;
  border-radius: 0;
}

.btn-cancel {
  background-color: #f5f5f5;
  color: #666;
}

.btn-confirm {
  background-color: #667eea;
  color: white;
  font-weight: 600;
}

.user-points {
  font-size: 30rpx;
  color: #667eea;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.user-actions {
  margin-top: 12rpx;
}

.points-btn {
  font-size: 28rpx;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
}
