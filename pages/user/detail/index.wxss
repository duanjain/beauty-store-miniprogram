.container {
  padding: 20rpx;
  background-color: #f5f7fa;
  min-height: 100vh;
}

.user-card {
  padding: 30rpx;
  background: white;
  margin-bottom: 30rpx;
}

.user-header {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-right: 30rpx;
  background-color: #eee;
}

.info {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.detail-row {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 6rpx;
  display: flex;
  align-items: center;
}

.highlight {
  color: #ff6b81;
  font-weight: bold;
}

.tabs {
  display: flex;
  background: white;
  padding: 0 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #2979ff;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40%;
  height: 4rpx;
  background-color: #2979ff;
  border-radius: 2rpx;
}

.list-item {
  background: white;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  border-bottom: 1rpx solid #eee;
  padding-bottom: 16rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: #999;
}

.status {
  font-weight: bold;
}
.status.paid, .status.confirmed { color: #52c41a; }
.status.pending { color: #faad14; }

.item-body {
  margin-bottom: 16rpx;
}

.product-row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.item-footer {
  border-top: 1rpx solid #eee;
  padding-top: 16rpx;
  text-align: right;
  font-size: 28rpx;
}

.discount {
  color: #ff6b81;
  font-size: 24rpx;
  margin-left: 10rpx;
}

.final-pay {
  font-weight: bold;
  font-size: 30rpx;
  margin-top: 8rpx;
}

.empty-state {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}