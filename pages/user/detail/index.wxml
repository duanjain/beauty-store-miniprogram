<wxs src="../../../utils/tools.wxs" module="tools" />
<view class="container page-wrapper">
  <!-- 用户信息卡片 -->
  <view class="user-card card">
    <view class="user-header">
      <image class="avatar" src="{{userInfo.avatarUrl || '/images/avatar-placeholder.png'}}" mode="aspectFill"></image>
      <view class="info">
        <view class="nickname">{{userInfo.nickname || '未设置昵称'}}</view>
        <view class="detail-row" bindtap="copyText" data-text="{{userInfo.phone}}">
          <text class="label">手机：</text>
          <text class="value">{{userInfo.phone || '未设置'}}</text>
        </view>
        <view class="detail-row">
          <text class="label">积分：</text>
          <text class="value highlight">{{tools.toFix(userInfo.points)}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 选项卡 -->
  <view class="tabs">
    <view class="tab-item {{activeTab === 'orders' ? 'active' : ''}}" bindtap="switchTab" data-tab="orders">
      订单记录 ({{orders.length}})
    </view>
    <view class="tab-item {{activeTab === 'appointments' ? 'active' : ''}}" bindtap="switchTab" data-tab="appointments">
      预约记录 ({{appointments.length}})
    </view>
  </view>

  <!-- 列表内容 -->
  <view class="list-content">
    <!-- 订单列表 -->
    <block wx:if="{{activeTab === 'orders'}}">
      <view class="empty-state" wx:if="{{orders.length === 0}}">暂无订单记录</view>
      <view class="list-item card" wx:for="{{orders}}" wx:key="_id">
        <view class="item-header">
          <text class="time">{{item.formattedTime}}</text>
          <text class="status {{item.status}}">{{item.status === 'paid' ? '已支付' : (item.status === 'pending' ? '待支付' : item.status)}}</text>
        </view>
        <view class="item-body">
          <view class="product-row" wx:for="{{item.items}}" wx:key="index" wx:for-item="prod">
            <text class="prod-name">{{prod.name}}</text>
            <text class="prod-info">x{{prod.quantity}}</text>
          </view>
        </view>
        <view class="item-footer">
          <view class="amount-row">
            <text>总额: ¥{{item.totalAmount}}</text>
            <text wx:if="{{item.pointsDeduction}}" class="discount"> (积分抵扣: ¥{{item.pointsDeduction}})</text>
          </view>
          <view class="final-pay" wx:if="{{item.finalAmount}}">实付: ¥{{item.finalAmount}}</view>
        </view>
      </view>
    </block>

    <!-- 预约列表 -->
    <block wx:if="{{activeTab === 'appointments'}}">
      <view class="empty-state" wx:if="{{appointments.length === 0}}">暂无预约记录</view>
      <view class="list-item card" wx:for="{{appointments}}" wx:key="_id">
        <view class="item-header">
          <text class="time">{{item.formattedTime}}</text>
          <text class="status {{item.status}}">{{item.status === 'confirmed' ? '已确认' : (item.status === 'pending' ? '待确认' : item.status)}}</text>
        </view>
        <view class="item-body">
          <view class="detail-row">
            <text class="label">服务：</text>
            <text class="value">{{item.serviceName}}</text>
          </view>
          <view class="detail-row">
            <text class="label">备注：</text>
            <text class="value">{{item.note || '无'}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>