<wxs src="../../../utils/tools.wxs" module="tools" />
<view class="container page-wrapper">
  <!-- 顶部积分概览 -->
  <view class="points-header card">
    <view class="points-title">当前积分</view>
    <view class="points-value">{{tools.toFix(userPoints)}}</view>
  </view>

  <!-- 积分明细列表 -->
  <view class="points-list">
    <view class="list-title">积分明细</view>
    
    <block wx:if="{{logs.length > 0}}">
      <view class="log-item card" wx:for="{{logs}}" wx:key="_id">
        <view class="log-left">
          <view class="log-source">{{item.description || (item.source === 'order' ? '购物奖励' : item.source === 'appointment' ? '预约奖励' : item.source === 'order_deduction' ? '购物抵扣' : '其他')}}</view>
          <view class="log-time">{{item.formattedTime}}</view>
        </view>
        <view class="log-right">
          <text class="log-change {{item.change > 0 ? 'plus' : 'minus'}}">{{item.change > 0 ? '+' : ''}}{{tools.toFix(item.change)}}</text>
          <view class="log-balance" wx:if="{{item.afterPoints !== undefined}}">余额: {{tools.toFix(item.afterPoints)}}</view>
        </view>
      </view>
    </block>
    
    <view class="empty-state" wx:else>
      <text>暂无积分记录</text>
    </view>
    
    <view class="load-more" wx:if="{{hasMore}}" bindtap="loadMore">
      <text>加载更多</text>
    </view>
  </view>
</view>
