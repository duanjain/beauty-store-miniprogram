.container {
  background-color: var(--bg-body);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* User Card - Modern Header */
.user-card {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  padding: 40rpx 32rpx 60rpx;
  color: #fff;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  overflow: hidden;
  margin-right: 24rpx;
  background-color: #fff;
}

.user-avatar image {
  width: 100%;
  height: 100%;
}

.user-details {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  display: block;
}

.user-role-tag {
  display: inline-block;
  background-color: rgba(0, 0, 0, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.user-stats {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.8;
}

/* Cards */
.card {
  margin: 0 24rpx 24rpx;
  background-color: #fff;
  border-radius: var(--radius-md);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.card-more {
  font-size: 24rpx;
  color: var(--text-tertiary);
  display: flex;
  align-items: center;
}

.arrow {
  margin-left: 4rpx;
}

/* Order Status Grid */
.status-grid {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 10rpx;
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  flex: 1;
}

.status-icon {
  font-size: 40rpx;
  width: 88rpx;
  height: 88rpx;
  background-color: #f7f8fa;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  transition: all 0.3s ease;
}

.status-item:active .status-icon {
  background-color: #e6f7ff;
  transform: scale(0.95);
}

.status-text {
  font-size: 26rpx;
  color: var(--text-main);
}

/* Menu List */
.menu-list {
  display: flex;
  flex-direction: column;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 24rpx;
  width: 64rpx;
  height: 64rpx;
  background-color: #fff9fa;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary-color);
}

.menu-text {
  font-size: 30rpx;
  color: var(--text-main);
}

.menu-arrow {
  color: var(--text-tertiary);
  font-size: 28rpx;
}

/* Logout Button */
.logout-section {
  padding: 40rpx 24rpx;
}

.logout-btn {
  background-color: #fff;
  color: var(--text-secondary);
  font-size: 30rpx;
  border-radius: var(--radius-round);
  border: 1rpx solid var(--border-color);
}

.logout-btn:active {
  background-color: #f5f5f5;
}
