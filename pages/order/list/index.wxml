<view class='container page-wrapper order-list-page'>
  <!-- 管理员端：顶部导航 -->
  <view class='top-nav' wx:if='{{isAdmin}}'>
    <view class='nav-item {{activeNav === "product" ? "active" : ""}}' bindtap='switchNav' data-nav='product'>
      <view class='nav-icon'>
        <text>📦</text>
      </view>
      <text class='nav-text'>商品管理</text>
    </view>
    <view class='nav-item {{activeNav === "service" ? "active" : ""}}' bindtap='switchNav' data-nav='service'>
      <view class='nav-icon'>
        <text>💆</text>
      </view>
      <text class='nav-text'>服务管理</text>
    </view>
    <view class='nav-item {{activeNav === "appointment" ? "active" : ""}}' bindtap='switchNav' data-nav='appointment'>
      <view class='nav-icon'>
        <text>📅</text>
      </view>
      <text class='nav-text'>预约管理</text>
    </view>
    <view class='nav-item {{activeNav === "order" ? "active" : ""}}' bindtap='switchNav' data-nav='order'>
      <view class='nav-icon'>
        <text>📋</text>
      </view>
      <text class='nav-text'>订单管理</text>
    </view>
    <view class='nav-item {{activeNav === "user" ? "active" : ""}}' bindtap='switchNav' data-nav='user'>
      <view class='nav-icon'>
        <text>👤</text>
      </view>
      <text class='nav-text'>顾客管理</text>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class='search-bar card' wx:if='{{isAdmin}}'>
    <input type='text' placeholder='{{isAdmin ? "搜索顾客姓名或联系电话" : "搜索订单号"}}' bindinput='onSearchInput' value='{{searchKeyword}}' />
    <button class='search-btn btn-primary' bindtap='onSearch'>搜索</button>
  </view>

  <!-- 用户端：订单类型切换 (商品订单/服务预约) -->
  <view class="type-tabs" wx:if="{{!isAdmin}}">
    <view class="type-tab-item {{activeTab === 'product' ? 'active' : ''}}" bindtap="onTypeTabChange" data-type="product">商品订单</view>
    <view class="type-tab-item {{activeTab === 'appointment' ? 'active' : ''}}" bindtap="onTypeTabChange" data-type="appointment">服务预约</view>
  </view>

  <!-- 状态筛选 Tab (商品订单) -->
  <view class="status-tabs" wx:if="{{isAdmin || activeTab === 'product'}}">
    <view class="tab-item {{currentStatus === 'all' ? 'active' : ''}}" bindtap="onTabChange" data-status="all">全部</view>
    <view class="tab-item {{currentStatus === 'pending_pay' ? 'active' : ''}}" bindtap="onTabChange" data-status="pending_pay">待付款</view>
    <view class="tab-item {{currentStatus === 'pending_ship' ? 'active' : ''}}" bindtap="onTabChange" data-status="pending_ship">待发货</view>
    <view class="tab-item {{currentStatus === 'shipped' ? 'active' : ''}}" bindtap="onTabChange" data-status="shipped">待收货</view>
    <view class="tab-item {{currentStatus === 'completed' ? 'active' : ''}}" bindtap="onTabChange" data-status="completed">已完成</view>
  </view>

  <!-- 状态筛选 Tab (服务预约) -->
  <view class="status-tabs" wx:if="{{!isAdmin && activeTab === 'appointment'}}">
    <view class="tab-item {{currentStatus === 'all' ? 'active' : ''}}" bindtap="onTabChange" data-status="all">全部</view>
    <view class="tab-item {{currentStatus === 'pending' ? 'active' : ''}}" bindtap="onTabChange" data-status="pending">待确认</view>
    <view class="tab-item {{currentStatus === 'paid' ? 'active' : ''}}" bindtap="onTabChange" data-status="paid">已付款</view>
    <view class="tab-item {{currentStatus === 'confirmed' ? 'active' : ''}}" bindtap="onTabChange" data-status="confirmed">已确认</view>
    <view class="tab-item {{currentStatus === 'completed' ? 'active' : ''}}" bindtap="onTabChange" data-status="completed">已完成</view>
  </view>

  <!-- 订单列表 (商品) -->
  <view class='order-list' wx:if="{{isAdmin || activeTab === 'product'}}">
    <block wx:for='{{orders}}' wx:key='_id'>
      <view class='order-item'>
        <view class='order-header'>
          <text class='order-id'>订单号: {{item._id}}</text>
          <text class='order-status {{item.status === "pending" ? "pending" : item.status === "paid" ? "paid" : item.status === "confirmed" ? "confirmed" : item.status === "shipped" ? "shipped" : item.status === "completed" ? "completed" : "cancelled"}}'>
            {{item.status === "pending" ? "待付款" : item.status === "paid" ? "已付款" : item.status === "confirmed" ? "已确认" : item.status === "shipped" ? "已发货" : item.status === "completed" ? "已完成" : "已取消"}}
          </text>
        </view>
        <view class='order-info'>
          <text class='order-total'>总金额: ¥{{item.totalAmount}}</text>
          <text class='order-final' wx:if="{{item.pointsUsed > 0}}" style="display: block; font-size: 24rpx; color: #ff6b81;">实付: ¥{{item.finalAmount}} (积分抵扣: ¥{{item.pointsDeduction}})</text>
          <text class='order-date'>创建时间: {{item.formattedCreateTime}}</text>
        </view>
        
        <!-- 管理员端：显示用户信息 -->
        <view class='order-user' wx:if='{{isAdmin}}'>
          <text class='user-label'>用户信息:</text>
          <text class='user-detail'>{{item.userId}}</text>
        </view>
        
        <view class='order-actions'>
          <button class='view-btn btn-secondary' bindtap='navigateToDetailOrder' data-id='{{item._id}}'>查看详情</button>
          <!-- 管理员端：显示修改状态按钮 -->
          <button class='status-btn btn-primary' type='primary' bindtap='onChangeStatus' data-id='{{item._id}}' data-status='{{item.status}}' wx:if='{{isAdmin}}'>
            修改状态
          </button>
        </view>
      </view>
    </block>
    
    <!-- 空状态提示 (商品) -->
    <view class='empty-state' wx:if='{{orders.length === 0}}'>
      <image class="empty-img" src="https://img.yzcdn.cn/vant/empty-image-default.png" mode="widthFix"></image>
      <text class='empty-text' wx:if='{{isAdmin && searchKeyword}}'>无该用户或联系方式的订单</text>
      <text class='empty-text' wx:else>暂无订单数据</text>
    </view>
    
    <!-- 加载更多 (商品) -->
    <view class='load-more' wx:if='{{hasMore}}' bindtap='loadMore'>
      <text>加载更多</text>
    </view>
  </view>

  <!-- 预约列表 (服务) -->
  <view class='appointment-list-section' wx:if="{{!isAdmin && activeTab === 'appointment'}}">
    <view class='order-list'>
      <block wx:for='{{appointments}}' wx:key='_id'>
        <view class='order-item appointment-item'>
           <!-- Reuse order-item styles but customize content -->
           <view class='order-header'>
              <text class='service-name' style="font-weight:bold; font-size:30rpx;">{{item.serviceName}}</text>
              <text class='order-status {{item.status}}'>{{item.statusText}}</text>
           </view>
           
           <view class='order-info'>
             <text class='appointment-time' style="display:block; margin-bottom:10rpx;">预约时间: {{item.formattedAppointmentDate}} {{item.timeSlot}}</text>
             <text class='contact-info' style="display:block; color:#666; font-size:26rpx;">联系人: {{item.userName}} ({{item.phone}})</text>
           </view>

           <view class='order-actions'>
             <!-- 取消预约按钮 - 待确认或已付款的预约才能取消 -->
             <button class='view-btn btn-danger' type='warn' bindtap='cancelAppointment' data-id='{{item._id}}' wx:if='{{item.status === "pending" || item.status === "paid"}}' style="background:#fff; color:#ff4d4f; border:1rpx solid #ff4d4f;">取消预约</button>
             
             <!-- 联系管理员提示 - 已确认或已完成的预约 -->
             <view class='contact-tip' wx:if='{{item.status === "confirmed" || item.status === "completed"}}' style="font-size:24rpx; color:#999;">
               如需取消请联系客服
             </view>
           </view>
        </view>
      </block>
      
      <!-- 空状态提示 (预约) -->
      <view class='empty-state' wx:if='{{appointments.length === 0}}'>
        <image class="empty-img" src="https://img.yzcdn.cn/vant/empty-image-default.png" mode="widthFix"></image>
        <text class='empty-text'>暂无预约数据</text>
      </view>

      <!-- 加载更多 (预约) -->
      <view class='load-more' wx:if='{{appointmentHasMore}}' bindtap='loadMore'>
        <text>加载更多</text>
      </view>
    </view>
  </view>
</view>
