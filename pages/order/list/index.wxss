.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 顶部导航栏样式 */
.top-nav {
  display: flex;
  justify-content: space-between;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  padding: 12rpx;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 16rpx;
  border-radius: 12rpx;
  transition: all 0.3s ease;
  position: relative;
  background: transparent;
}

.nav-item:hover {
  background: rgba(255, 255, 255, 0.1);
  transform: translateY(-2rpx);
}

.nav-item.active {
  background: white;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.nav-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.nav-text {
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

/* 默认（未激活）状态下的文字颜色 */
.nav-item:not(.active) .nav-text {
  color: rgba(255, 255, 255, 0.9);
}

/* 激活状态下的文字颜色 */
.nav-item.active .nav-text {
  color: #667eea;
}

/* 移除旧的下划线样式 */
.nav-item.active::after {
  display: none;
}

/* 状态 Tabs */
.type-tabs {
  display: flex;
  background-color: #fff;
  border-radius: var(--radius-md);
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.type-tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: var(--text-secondary);
  font-weight: 500;
  position: relative;
}

.type-tab-item.active {
  color: var(--primary-color);
  font-weight: bold;
}

.type-tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: var(--primary-color);
  border-radius: 4rpx;
}

/* 状态 Tabs */
.status-tabs {
  display: flex;
  background-color: #fff;
  border-radius: var(--radius-md);
  margin-bottom: 24rpx;
  padding: 8rpx;
  box-shadow: var(--shadow-sm);
  overflow-x: auto;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
  border-radius: var(--radius-sm);
  white-space: nowrap;
  min-width: 120rpx;
}

.tab-item.active {
  color: var(--primary-color);
  font-weight: 600;
  background-color: var(--primary-light);
}

/* 搜索栏样式 */
.search-bar {
  display: flex;
  margin-bottom: 30rpx;
  padding: 0;
  overflow: hidden;
}

.search-bar input {
  flex: 1;
  height: 80rpx;
  border: none;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.search-btn {
  width: 160rpx;
  height: 80rpx;
  border-radius: 0;
  line-height: 80rpx;
  font-size: 28rpx;
  margin: 0;
}

/* 订单列表 */
.order-list {
  padding-bottom: 40rpx;
}

.order-item {
  background-color: #fff;
  border-radius: var(--radius-md);
  margin-bottom: 24rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border-color);
  margin-bottom: 16rpx;
}

.order-id {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.order-status {
  font-size: 26rpx;
  font-weight: 500;
}

.order-status.pending { color: var(--warning-color); }
.order-status.paid { color: var(--link-color); }
.order-status.confirmed { color: var(--link-color); }
.order-status.shipped { color: var(--link-color); }
.order-status.completed { color: var(--success-color); }
.order-status.cancelled { color: var(--text-tertiary); }

.order-info {
  margin-bottom: 16rpx;
}

.order-total {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.order-date {
  display: block;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.view-btn {
  margin: 0;
  font-size: 24rpx;
  padding: 10rpx 30rpx;
  line-height: 1.5;
}

.status-btn {
  margin: 0;
  font-size: 24rpx;
  padding: 10rpx 30rpx;
  line-height: 1.5;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-img {
  width: 200rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  color: var(--text-tertiary);
  font-size: 28rpx;
}

.load-more {
  text-align: center;
  padding: 20rpx;
  color: var(--text-tertiary);
  font-size: 24rpx;
}
