.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
}

.back-btn {
  font-size: 28rpx;
  padding: 8rpx 16rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.order-section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.label {
  width: 120rpx;
  font-size: 28rpx;
  color: #666;
}

.value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.status {
  flex: 1;
  font-size: 28rpx;
  font-weight: bold;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
}

.status.pending {
  color: #ff9800;
  background-color: #fff3e0;
}

.status.paid {
  color: #2196f3;
  background-color: #e3f2fd;
}

.status.confirmed {
  color: #3f51b5;
  background-color: #e8eaf6;
}
.status.shipped {
  color: #4caf50;
  background-color: #e8f5e9;
}

.status.completed {
  color: #9c27b0;
  background-color: #f3e5f5;
}

.status.cancelled {
  color: #f44336;
  background-color: #ffebee;
}

.status-btn {
  font-size: 26rpx;
  padding: 8rpx 16rpx;
  margin-left: 16rpx;
}

.products-list {
  margin-bottom: 16rpx;
}

.product-item {
  display: flex;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
}

.product-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.product-info {
  flex: 1;
}

.product-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.product-price {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.product-subtotal {
  display: block;
  font-size: 26rpx;
  color: #f44336;
  font-weight: bold;
}

.address-info {
  padding: 16rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}

.address-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
  font-weight: bold;
}

.address-phone {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.address-detail {
  display: block;
  font-size: 26rpx;
  color: #333;
}

.total-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
}

.total-label {
  color: #333;
  margin-right: 16rpx;
}

.total-value {
  color: #f44336;
}

.cancel-btn {
  margin-left: 120rpx;
  font-size: 28rpx;
  padding: 12rpx 24rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #ff9800;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  font-size: 28rpx;
  color: #666;
}
