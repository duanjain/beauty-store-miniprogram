<view class='container page-wrapper order-detail-page' wx:if='{{!loading}}'>
  <!-- 返回按钮 -->
  <view class='header card'>
    <button class='back-btn btn-secondary' bindtap='goBack'>返回订单列表</button>
    <text class='title'>订单详情</text>
  </view>

  <!-- 订单基本信息 -->
  <view class='order-section card'>
    <view class='section-title'>订单基本信息</view>
    <view class='info-row'>
      <text class='label'>订单号:</text>
      <text class='value'>{{order._id}}</text>
    </view>
    <view class='info-row'>
      <text class='label'>订单状态:</text>
      <text class='status {{order.status === "pending" ? "pending" : order.status === "paid" ? "paid" : order.status === "confirmed" ? "confirmed" : order.status === "shipped" ? "shipped" : order.status === "completed" ? "completed" : "cancelled"}}'>
        {{order.status === "pending" ? "待付款" : order.status === "paid" ? "已付款" : order.status === "confirmed" ? "已确认" : order.status === "shipped" ? "已发货" : order.status === "completed" ? "已完成" : "已取消"}}
      </text>
      <button class='status-btn' type='primary' bindtap='onChangeStatus' data-status='{{order.status}}' wx:if='{{isAdmin}}'>修改状态</button>
    </view>
    <view class='info-row'>
      <text class='label'>创建时间:</text>
      <text class='value'>{{order.formattedCreateTime}}</text>
    </view>
    <view class='info-row' wx:if='{{!isAdmin && (order.status === "paid" || order.status === "pending")}}'>
      <button class='cancel-btn' type='warn' bindtap='onCancelOrder'>取消订单</button>
    </view>
    <view class='info-row' wx:if='{{!isAdmin && order.status === "confirmed"}}'>
      <text class='value tip-text'>订单已确认，如需取消请联系管理员</text>
    </view>
  </view>

  <!-- 订单商品信息 -->
  <view class='order-section card'>
    <view class='section-title'>商品信息</view>
    <view class='products-list'>
      <block wx:for='{{order.items}}' wx:key='_id'>
        <view class='product-item'>
          <image class='product-image' src='{{item.imageUrl}}' mode='aspectFill'></image>
          <view class='product-info'>
            <text class='product-name'>{{item.name}}</text>
            <text class='product-price'>¥{{item.price}} × {{item.quantity}}</text>
            <text class='product-subtotal'>小计: ¥{{item.subtotal}}</text>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 收货地址 -->
  <view class='order-section card' wx:if='{{order.address}}'>
    <view class='section-title'>收货地址</view>
    <view class='address-info'>
      <text class='address-name'>{{order.address.name}}</text>
      <text class='address-phone'>{{order.address.phone}}</text>
      <text class='address-detail'>{{order.address.province}}{{order.address.city}}{{order.address.district}}{{order.address.address}} {{order.address.detail}}</text>
    </view>
  </view>

  <!-- 订单金额 -->
  <view class='order-section card'>
    <view class='section-title'>订单金额</view>
    <view class='total-row'>
      <text class='total-label'>总金额:</text>
      <text class='total-value'>¥{{order.totalAmount}}</text>
    </view>
    <view class='total-row' wx:if="{{order.pointsUsed > 0}}">
      <text class='total-label'>积分抵扣:</text>
      <text class='total-value' style="color: #ff6b81;">-¥{{order.pointsDeduction}} ({{order.pointsUsed}}积分)</text>
    </view>
    <view class='total-row' wx:if="{{order.pointsUsed > 0}}">
      <text class='total-label'>实付金额:</text>
      <text class='total-value highlight'>¥{{order.finalAmount}}</text>
    </view>
  </view>
</view>

<!-- 加载状态 -->
<view class='loading' wx:else>
  <text>加载中...</text>
</view>
