/* 首页样式 */
.container {
  background-color: var(--bg-body);
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background-color: #fff;
  z-index: 1000;
  box-shadow: 0 1rpx 0 rgba(0,0,0,0.05);
}

.nav-content {
  display: flex;
  align-items: center;
  padding-left: 32rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-main);
}

.page-content {
  padding-bottom: 20rpx;
}

/* 搜索区域 */
.search-section {
  background-color: #fff;
  padding: 16rpx 24rpx;
  position: sticky;
  z-index: 100;
}

.search-box {
  background-color: #f7f8fa;
  border-radius: 32rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.search-icon {
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main);
}

.placeholder {
  color: var(--text-tertiary);
}

.search-btn {
  font-size: 28rpx;
  color: var(--primary-color);
  padding-left: 20rpx;
  font-weight: 500;
  border-left: 1rpx solid #e0e0e0;
  line-height: 32rpx;
  margin-left: 10rpx;
}

/* Banner */
.banner-section {
  padding: 24rpx;
  background-color: #fff;
}

.banner-swiper {
  height: 300rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  transform: translateY(0); /* Fix for border-radius on some devices */
}

.banner-image {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-md);
}

/* 分类滚动条 */
.category-scroll-view {
  background-color: #fff;
  padding: 10rpx 0 20rpx;
  white-space: nowrap;
}

.category-list {
  display: flex;
  padding: 0 24rpx;
  height: 80rpx; /* 增加高度 */
  align-items: center;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 32rpx;
  padding: 12rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  position: relative;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border-radius: 32rpx; /* 胶囊形状 */
  background-color: transparent;
}

.category-item:last-child {
  margin-right: 24rpx; /* 最后一个元素右侧留白 */
}

.category-item.active {
  color: #fff;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
  font-weight: 500;
  font-size: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 129, 0.3);
  transform: scale(1.05);
}

.active-indicator {
  display: none; /* 移除旧的下划线样式，改用背景色 */
}

/* 商品列表 Grid */
.products-grid {
  padding: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.product-card {
  background-color: #fff;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
}

.product-img-box {
  width: 100%;
  height: 340rpx;
  background-color: #f7f8fa;
  position: relative;
}

.product-image {
  width: 100%;
  height: 100%;
}

.product-info {
  padding: 16rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  color: var(--text-main);
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
  height: 80rpx;
}

.product-tags {
  margin-bottom: 12rpx;
  height: 32rpx;
}

.tag {
  font-size: 20rpx;
  color: #ff6b81;
  background-color: rgba(255, 107, 129, 0.1);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.price-box {
  display: flex;
  align-items: baseline;
  color: var(--error-color);
}

.currency {
  font-size: 24rpx;
  margin-right: 2rpx;
}

.price {
  font-size: 36rpx;
  font-weight: 600;
  font-family: 'DIN', sans-serif;
}

.add-btn {
  width: 56rpx;
  height: 56rpx;
  background-color: var(--primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 129, 0.3);
}

.cart-icon {
  width: 32rpx;
  height: 32rpx;
  filter: brightness(100); /* Make it white if icon is black */
}

/* Loading More */
.loading-more, .no-more {
  grid-column: span 2;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 26rpx;
}

.loading-spinner {
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: var(--primary-color);
  border-radius: 50%;
  margin-right: 12rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Empty State */
.empty-state {
  grid-column: span 2;
}

/* Admin Section */
.admin-section {
  background: #fff;
  margin: 24rpx;
  padding: 24rpx;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

.section-header {
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid var(--primary-color);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
}

.admin-grid {
  display: flex;
  flex-wrap: wrap;
}

.admin-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.admin-icon-box {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 12rpx;
  background-color: #f5f5f5;
}

.color-blue { background-color: #e6f7ff; }
.color-purple { background-color: #f9f0ff; }
.color-orange { background-color: #fff7e6; }
.color-green { background-color: #f6ffed; }
.color-pink { background-color: #fff0f6; }

.admin-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* Skeleton Loading */
.skeleton-grid {
  pointer-events: none;
}

.skeleton-card {
  background-color: #fff;
}

.skeleton-rect, .skeleton-text, .skeleton-circle {
  background-color: #f2f3f5;
  animation: shimmer 1.5s infinite linear;
  background-image: linear-gradient(90deg, #f2f3f5 25%, #e6e8eb 37%, #f2f3f5 63%);
  background-size: 400% 100%;
}

.skeleton-rect {
  width: 100%;
  height: 100%;
}

.skeleton-text {
  height: 28rpx;
  border-radius: 4rpx;
  margin-bottom: 12rpx;
}

.title-skeleton {
  width: 80%;
}

.title-skeleton.short {
  width: 50%;
}

.price-skeleton {
  width: 100rpx;
  height: 40rpx;
}

.skeleton-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
}

@keyframes shimmer {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}
