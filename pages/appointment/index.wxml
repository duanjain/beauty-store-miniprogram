<view class='container page-wrapper appointment-admin-page'>
  <!-- 管理员端预约管理 -->
  <view wx:if='{{isAdmin}}'>
    <!-- 顶部导航 - 与其他管理页面保持一致 -->
    <view class='top-nav'>
      <view class='nav-item {{activeNav === "product" ? "active" : ""}}' bindtap='switchNav' data-nav='product'>
        <view class='nav-icon'>
          <text>📦</text>
        </view>
        <text class='nav-text'>商品管理</text>
      </view>
      <view class='nav-item {{activeNav === "service" ? "active" : ""}}' bindtap='switchNav' data-nav='service'>
        <view class='nav-icon'>
          <text>💆</text>
        </view>
        <text class='nav-text'>服务管理</text>
      </view>
      <view class='nav-item {{activeNav === "appointment" ? "active" : ""}}' bindtap='switchNav' data-nav='appointment'>
        <view class='nav-icon'>
          <text>📅</text>
        </view>
        <text class='nav-text'>预约管理</text>
      </view>
      <view class='nav-item {{activeNav === "order" ? "active" : ""}}' bindtap='switchNav' data-nav='order'>
        <view class='nav-icon'>
          <text>📋</text>
        </view>
        <text class='nav-text'>订单管理</text>
      </view>
      <view class='nav-item {{activeNav === "user" ? "active" : ""}}' bindtap='switchNav' data-nav='user'>
        <view class='nav-icon'>
          <text>👤</text>
        </view>
        <text class='nav-text'>顾客管理</text>
      </view>
    </view>

    <!-- 筛选和搜索区域 -->
    <view class='filter-row'>
      <!-- 状态筛选 -->
      <view class='filter-section'>
        <text class='filter-label'>状态：</text>
        <picker bindchange='onStatusChange' value='{{statusIndex}}' range='{{statusOptions}}' range-key='text'>
          <view class='filter-picker'>
            {{currentStatusText}}
          </view>
        </picker>
      </view>
      
      <!-- 搜索框 -->
      <view class='search-section'>
        <input type='text' placeholder='搜索预约人/联系电话' bindinput='onSearchInput' value='{{keyword}}' />
        <button class='search-btn' bindtap='onSearch'>搜索</button>
      </view>
    </view>

    <!-- 加载状态 -->
    <view wx:if='{{loading && appointments.length === 0}}' class='loading'>
      <text>加载中...</text>
    </view>

    <!-- 空状态提示 -->
    <view wx:elif='{{appointments.length === 0}}' class='empty-state'>
      <text>暂无预约数据</text>
    </view>

    <!-- 预约列表 -->
    <view class='appointment-list'>
      <block wx:for='{{appointments}}' wx:key='_id'>
        <view class='appointment-item card card-interactive'>
          <!-- 直接在预约项顶部显示醒目的订单状态 -->
          <view class='simple-status status-{{item.status}}'>
            {{item.status === "pending" ? "待确认" : item.status === "paid" ? "已付款" : item.status === "confirmed" ? "已确认" : item.status === "completed" ? "已完成" : "已取消"}}
          </view>

          <!-- 预约基本信息 -->
          <view class='appointment-header'>
            <view class='service-info'>
              <text class='service-name'>{{item.serviceName}}</text>
            </view>
          </view>

          <!-- 预约详细信息 -->
          <view class='appointment-details'>
            <view class='detail-row'>
              <text class='detail-label'>预约人：</text>
              <text class='detail-value'>{{item.userName || '未设置'}}</text>
            </view>
            <view class='detail-row'>
              <text class='detail-label'>联系电话：</text>
              <text class='detail-value'>{{item.phone || '未设置'}}</text>
            </view>
            <view class='detail-row'>
              <text class='detail-label'>预约时间：</text>
              <text class='detail-value'>
                {{item.formattedAppointmentDate ? (item.formattedAppointmentDate + ' ' + (item.timeSlot || '10:00 - 10:30')) : '2026-01-14 10:00 - 10:30'}}
              </text>
            </view>
            <view class='detail-row'>
              <text class='detail-label'>订单时间：</text>
              <text class='detail-value'>
                {{item.formattedCreateDate || '2026-01-14 10:00'}}
              </text>
            </view>
          </view>

          <!-- 操作按钮 -->
          <view class='service-actions'>
            <button 
              wx:if='{{item.status === "pending" || item.status === "paid"}}'
              class='view-btn'
              data-_id='{{item._id}}' 
              data-status='confirmed'
              bindtap='updateAppointmentStatus'
            >
              确认预约
            </button>
            <button 
              wx:if='{{item.status === "pending" || item.status === "paid" || item.status === "confirmed"}}'
              class='edit-btn'
              data-_id='{{item._id}}' 
              data-status='completed'
              bindtap='updateAppointmentStatus'
            >
              标记完成
            </button>
            <button 
              wx:if='{{item.status !== "cancelled"}}'
              class='delete-btn' type='warn'
              data-_id='{{item._id}}' 
              data-status='cancelled'
              bindtap='updateAppointmentStatus'
            >
              取消预约
            </button>
            <!-- 恢复预约按钮 - 仅对已取消的预约显示 -->
            <button 
              wx:if='{{item.status === "cancelled"}}'
              class='recovery-btn'
              data-_id='{{item._id}}' 
              data-status='pending'
              bindtap='updateAppointmentStatus'
            >
              恢复预约
            </button>
          </view>
        </view>
      </block>
    </view>

    <!-- 加载更多 -->
    <view class='load-more' wx:if='{{hasMore}}' bindtap='onReachBottom'>
      <text>加载更多</text>
    </view>

    <!-- 加载中 -->
    <view class='loading' wx:if='{{loading && appointments.length > 0}}'>
      <text>加载中...</text>
    </view>
  </view>

  <!-- 客户端服务列表 -->
  <view wx:else>
    <!-- 页面标题 -->
    <view class='page-header'>
      <text class='page-title'>服务预约</text>
    </view>

    <!-- 搜索栏 -->
    <view class='search-bar'>
      <input type='text' placeholder='搜索服务' bindinput='onSearchInput' value='{{keyword}}' />
      <button class='search-btn' bindtap='onSearch'>搜索</button>
    </view>

    <!-- 加载状态 -->
    <view wx:if='{{loading && services.length === 0}}' class='loading'>
      <text>加载中...</text>
    </view>

    <!-- 空状态提示 -->
    <view wx:elif='{{services.length === 0}}' class='empty-state'>
      <image class="empty-img" src="https://img.yzcdn.cn/vant/empty-image-default.png" mode="widthFix"></image>
      <text class='empty-text'>暂无服务数据</text>
    </view>

    <!-- 服务列表 -->
    <view wx:else class='service-list'>
      <block wx:for='{{services}}' wx:key='_id'>
        <view class='service-item' bindtap='navigateToServiceDetail' data-id='{{item._id}}'>
          <!-- 服务图片 -->
          <view class='service-image'>
            <image src='{{item.images && item.images.length > 0 ? item.images[0] : "/images/default-service.png"}}' mode='aspectFill'></image>
          </view>
          
          <!-- 服务信息 -->
          <view class='service-info'>
            <text class='service-name'>{{item.serviceName}}</text>
            <text class='service-description'>{{item.description}}</text>
            <view class='service-meta'>
              <text class='service-price'>¥{{item.price}}</text>
              <text class='service-duration'>{{item.duration}}分钟</text>
            </view>
          </view>
        </view>
      </block>
    </view>

    <!-- 加载更多 -->
    <view class='load-more' wx:if='{{hasMore}}' bindtap='onReachBottom'>
      <text>加载更多</text>
    </view>

    <!-- 加载中 -->
    <view class='loading' wx:if='{{loading && services.length > 0}}'>
      <text>加载中...</text>
    </view>
  </view>
</view>
