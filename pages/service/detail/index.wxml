<view class='container page-wrapper service-detail-page'>
  <view class='new-layout card'>
    <text class='new-title'>新服务详情页面</text>
    
    <!-- 服务图片 -->
    <view class='image-section'>
      <block wx:if='{{service.images && service.images.length > 0}}'>
        <block wx:for='{{service.images}}' wx:key='index'>
          <image class='service-image' src='{{item}}' mode='aspectFill' binderror='onImageError' bindtap='previewImage' data-index='{{index}}'></image>
        </block>
      </block>
      <view wx:else class='image-placeholder'>
        <text class='placeholder-text'>暂无服务图片</text>
      </view>
    </view>
    
    <view class='info-section'>
      <view class='info-item'>
        <text class='info-label'>服务名称：</text>
        <text class='info-value'>{{service.serviceName || '未设置'}}</text>
      </view>
      
      <view class='info-item'>
        <text class='info-label'>价格：</text>
        <text class='info-value price'>¥{{service.price || 0}}</text>
      </view>
      
      <view class='info-item'>
        <text class='info-label'>时长：</text>
        <text class='info-value'>{{service.duration || 0}}分钟</text>
      </view>
      
      <view class='info-item'>
        <text class='info-label'>描述：</text>
        <text class='info-value description'>{{service.description || '暂无描述'}}</text>
      </view>
      
      <!-- 管理员端：显示创建时间 -->
      <view class='info-item' wx:if='{{isAdmin}}'>
        <text class='info-label'>创建时间：</text>
        <text class='info-value'>{{formattedCreateTime}}</text>
      </view>
    </view>
    
    <view class='settings-section'>
      <text class='section-title'>预约设置</text>
      
      <view class='setting-item'>
        <text class='setting-label'>时间粒度：</text>
        <text class='setting-value'>{{service.timeSettings.timeGranularity || 0}}分钟</text>
      </view>
      
      <view class='setting-item'>
        <text class='setting-label'>营业时间：</text>
        <text class='setting-value'>{{service.timeSettings.dailyStartTime || '09:00'}} - {{service.timeSettings.dailyEndTime || '21:00'}}</text>
      </view>
      
      <view class='setting-item'>
        <text class='setting-label'>营业日：</text>
        <text class='setting-value'>{{formattedAvailableDays}}</text>
      </view>
      
      <view class='setting-item'>
        <text class='setting-label'>每时段容量：</text>
        <text class='setting-value'>{{service.timeSettings.maxCapacity || 1}}人</text>
      </view>
    </view>
    
    <!-- 预约表单 - 仅用户端显示，管理员端绝对不显示 -->
    <view class='appointment-section' wx:if='{{!isAdmin && !isAdmin}}'>
      <text class='section-title'>在线预约</text>
      
      <view class='form-item'>
        <text class='form-label'>选择日期：</text>
        <picker mode='date' value='{{selectedDate}}' start='{{minDate}}' end='{{maxDate}}' bindchange='onDateChange'>
          <view class='picker-value'>{{selectedDate || '请选择预约日期'}}</view>
        </picker>
      </view>
      
      <view class='form-item'>
        <text class='form-label'>选择时间：</text>
        <picker mode='selector' range='{{availableTimeSlots}}' value='{{selectedTimeIndex}}' bindchange='onTimeChange'>
          <view class='picker-value'>{{selectedTime || '请选择时间段'}}</view>
        </picker>
      </view>
      
      <view class='form-item'>
        <text class='form-label'>联系人：</text>
        <input type='text' placeholder='请输入联系人姓名' bindinput='onNameInput' value='{{contactName}}' class='form-input' />
      </view>
      
      <view class='form-item'>
        <text class='form-label'>手机号：</text>
        <input type='number' placeholder='请输入联系电话' bindinput='onPhoneInput' value='{{contactPhone}}' class='form-input' />
      </view>
      
      <button class='appointment-button' bindtap='submitAppointment' disabled='{{!selectedDate || !selectedTime || !contactName || !contactPhone}}'>
        提交预约
      </button>
    </view>
    
    <!-- 管理员操作按钮 - 仅管理员端显示 -->
    <view class='admin-actions' wx:if='{{isAdmin}}'>
      <button class='edit-btn' type='primary' bindtap='navigateToEdit'>编辑服务</button>
      <button class='delete-btn' type='warn' bindtap='deleteService'>删除服务</button>
    </view>
    
    <button class='back-button btn-secondary' bindtap='navigateBack'>返回列表</button>
  </view>
</view>
