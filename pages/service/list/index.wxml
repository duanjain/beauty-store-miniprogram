<view class='container page-wrapper service-list-page'>
  <!-- 顶部导航 -->
  <view class='top-nav'>
    <view class='nav-item {{activeNav === "product" ? "active" : ""}}' bindtap='switchNav' data-nav='product'>
      <view class='nav-icon'>
        <text>📦</text>
      </view>
      <text class='nav-text'>商品管理</text>
    </view>
    <view class='nav-item {{activeNav === "service" ? "active" : ""}}' bindtap='switchNav' data-nav='service'>
      <view class='nav-icon'>
        <text>💆</text>
      </view>
      <text class='nav-text'>服务管理</text>
    </view>
    <view class='nav-item {{activeNav === "appointment" ? "active" : ""}}' bindtap='switchNav' data-nav='appointment'>
      <view class='nav-icon'>
        <text>📅</text>
      </view>
      <text class='nav-text'>预约管理</text>
    </view>
    <view class='nav-item {{activeNav === "order" ? "active" : ""}}' bindtap='switchNav' data-nav='order'>
      <view class='nav-icon'>
        <text>📋</text>
      </view>
      <text class='nav-text'>订单管理</text>
    </view>
    <view class='nav-item {{activeNav === "user" ? "active" : ""}}' bindtap='switchNav' data-nav='user'>
      <view class='nav-icon'>
        <text>👤</text>
      </view>
      <text class='nav-text'>顾客管理</text>
    </view>
  </view>

  <!-- 顶部添加按钮 -->
  <view class='header'>
    <button class='add-btn btn-primary' type='primary' bindtap='navigateToAddService'>添加服务</button>
  </view>

  <!-- 搜索栏 -->
  <view class='search-bar card'>
    <input type='text' placeholder='搜索服务名称' bindinput='onSearchInput' value='{{searchKeyword}}' />
    <button class='search-btn' bindtap='onSearch'>搜索</button>
  </view>

  <!-- 服务列表 -->
  <view class='service-list'>
    <block wx:for='{{services}}' wx:key='_id'>
      <view class='service-item card card-interactive'>
        <image class='service-image' src='{{item.images[0] || ""}}' mode='aspectFill'></image>
        <view class='service-info'>
          <text class='service-name'>{{item.serviceName}}</text>
          <text class='service-price'>¥{{item.price}}</text>
          <text class='service-duration'>时长: {{item.duration}}分钟</text>
          <text class='service-description'>{{item.description}}</text>
          <text class='service-date'>创建时间: {{item.formattedCreatedAt}}</text>
        </view>
        <view class='service-actions'>
          <button class='view-btn btn-secondary' bindtap='navigateToDetail' data-id='{{item._id}}'>查看详情</button>
          <button class='edit-btn btn-primary' bindtap='navigateToEdit' data-id='{{item._id}}'>编辑</button>
          <button class='delete-btn btn-danger' type='warn' bindtap='deleteService' data-id='{{item._id}}'>删除</button>
        </view>
      </view>
    </block>
  </view>

  <!-- 空状态提示 -->
  <view class='empty-state' wx:if='{{services.length === 0}}'>
    <text>暂无服务数据</text>
    <text class='empty-hint'>点击右上角"添加服务"按钮开始添加服务</text>
  </view>

  <!-- 加载更多 -->
  <view class='load-more' wx:if='{{hasMore}}' bindtap='onReachBottom'>
    <text>加载更多</text>
  </view>

  <!-- 加载中 -->
  <view class='loading' wx:if='{{loading && services.length > 0}}'>
    <text>加载中...</text>
  </view>
</view>
