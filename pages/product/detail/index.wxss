/* 详情页样式 */
.container {
  background-color: var(--bg-body);
  min-height: 100vh;
  padding-bottom: 0;
}

/* 轮播图 */
.product-swiper {
  width: 100%;
  height: 750rpx; /* 正方形大图 */
  background-color: #fff;
}

.slide-image {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  width: 100%;
  height: 100%;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
}

/* 信息卡片 */
.info-card {
  background-color: #fff;
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.price-wrapper {
  display: flex;
  align-items: baseline;
  color: var(--error-color);
}

.currency {
  font-size: 28rpx;
  font-weight: 500;
  margin-right: 4rpx;
}

.price {
  font-size: 48rpx;
  font-weight: 600;
  font-family: 'DIN', sans-serif;
}

.original-price {
  font-size: 26rpx;
  color: var(--text-tertiary);
  text-decoration: line-through;
  margin-left: 16rpx;
}

.stock-tag {
  font-size: 24rpx;
  color: var(--success-color);
  background-color: rgba(82, 196, 26, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.stock-tag.out {
  color: var(--error-color);
  background-color: rgba(255, 77, 79, 0.1);
}

.product-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-main);
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.product-meta {
  display: flex;
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.product-meta text {
  margin-right: 32rpx;
}

/* 数量选择 */
.quantity-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.quantity-label {
  font-size: 28rpx;
  color: var(--text-main);
}

.stepper {
  display: flex;
  align-items: center;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  overflow: hidden;
}

.stepper-btn {
  width: 60rpx;
  height: 50rpx;
  line-height: 50rpx;
  text-align: center;
  background-color: #f8f8f8;
  font-size: 32rpx;
  color: #333;
}

.stepper-btn.disabled {
  color: #ccc;
  background-color: #f0f0f0;
}

.stepper-input {
  width: 80rpx;
  height: 50rpx;
  text-align: center;
  font-size: 28rpx;
  border-left: 1rpx solid #ddd;
  border-right: 1rpx solid #ddd;
  background-color: #fff;
  min-height: 50rpx; /* 确保高度一致 */
}

/* 描述卡片 */
.desc-card {
  background-color: #fff;
  padding: 32rpx 24rpx;
  min-height: 400rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 24rpx;
  position: relative;
  padding-left: 16rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 6rpx;
  bottom: 6rpx;
  width: 6rpx;
  background-color: var(--primary-color);
  border-radius: 4rpx;
}

.desc-content {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: #fff;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
  box-sizing: border-box;
  /* 垂直布局适配：允许换行 */
  flex-wrap: wrap;
  height: auto;
  
  /* 适配底部安全区域 */
  padding-bottom: 16rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.icon-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* 图标按钮平分第一行空间 */
  flex: 1;
  margin-right: 0; 
  font-size: 20rpx;
  color: var(--text-secondary);
  height: 80rpx; /* 固定高度 */
  padding: 0;
  background-color: transparent;
  line-height: 1.2;
}

.icon-btn::after {
  border: none;
}

.contact-btn {
  margin-right: 0;
  margin-left: 0;
  border-radius: 0;
}

.icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.action-btn-group {
  /* 按钮组独占第二行 */
  width: 100%;
  display: flex;
  height: 80rpx;
  overflow: hidden;
  margin-top: 16rpx; /* 与第一行图标的间距 */
  border-radius: 40rpx; /* 整体圆角 */
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  margin: 0;
  border-radius: 0;
  border: none;
  white-space: nowrap;
  padding: 0 4rpx;
}

.cart-btn {
  background: linear-gradient(to right, #ffd01e, #ff8917);
  color: #fff;
  /* 移除单独圆角，由 group 统一控制 */
  border-radius: 0;
}

.buy-btn {
  background: linear-gradient(to right, #ff6034, #ee0a24);
  color: #fff;
  /* 移除单独圆角，由 group 统一控制 */
  border-radius: 0;
}

.bottom-placeholder {
  /* 增加高度以适应两行布局: 80(icons) + 16(gap) + 80(btns) + 32(padding) ≈ 210rpx */
  height: 220rpx; 
  width: 100%;
  box-sizing: content-box;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
