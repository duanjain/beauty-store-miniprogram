.form-group {
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
  min-height: 120rpx;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  display: flex;
  align-items: center;
  background-color: white;
}

.form-submit {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
  padding: 20rpx;
}

.form-submit button {
  flex: 1;
  height: 80rpx;
  font-size: 32rpx;
}

/* 图片上传器样式 */
.image-uploader {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.image-item image {
  width: 100%;
  height: 100%;
  background-color: #f5f5f5;
}

.image-remove {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(255, 77, 79, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  cursor: pointer;
}

.image-preview {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 50rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: white;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #007aff;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: #007aff;
  background-color: rgba(0, 122, 255, 0.05);
  cursor: pointer;
}

.image-add:active {
  opacity: 0.6;
}

/* Category Modal */
.category-modal {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
}

.modal-confirm {
  color: #3a7bd5;
  font-size: 32rpx;
}

.modal-content {
  flex: 1;
  padding: 20rpx 0;
  overflow-y: auto;
}

.category-list {
  padding: 0 30rpx;
}

.category-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 30rpx;
}

.category-item checkbox {
  margin-right: 20rpx;
  transform: scale(0.9);
}
