.container {
  padding-bottom: 20rpx;
  background-color: #f5f5f5;
}

/* 搜索容器 */
.search-container {
  padding: 20rpx;
  background-color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.search-box {
  display: flex;
  align-items: center;
  background-color: #f0f0f0;
  border-radius: 60rpx;
  padding: 0 20rpx;
  height: 80rpx;
}

.search-icon {
  font-size: 36rpx;
  color: #999;
  margin-right: 10rpx;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 32rpx;
  background-color: transparent;
  outline: none;
}

.search-clear {
  font-size: 40rpx;
  color: #999;
  margin-left: 10rpx;
}

/* 分类导航 */
.category-scroll {
  white-space: nowrap;
  background-color: #fff;
  padding: 20rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 20rpx;
}

.category-item {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin: 0 10rpx;
  font-size: 32rpx;
  color: #666;
  border-radius: 40rpx;
  transition: all 0.3s;
}

.category-item.active {
  background-color: #ff6b81;
  color: #fff;
}

/* 商品容器 */
.product-container {
  display: flex;
  flex-wrap: wrap;
  padding: 0 10rpx;
  justify-content: space-between;
}

/* 商品卡片 */
.product-card {
  width: 345rpx;
  margin: 15rpx 10rpx;
  overflow: hidden;
  transition: transform 0.3s, box-shadow 0.3s;
}

.product-card:active {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.15);
}

.product-image-wrapper {
  position: relative;
  width: 100%;
  height: 345rpx;
  overflow: hidden;
}

.product-image {
  width: 100%;
  height: 100%;
  display: block;
  transition: transform 0.3s;
}

.product-card:active .product-image {
  transform: scale(1.05);
}

.product-tag {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  background-color: rgba(255, 0, 0, 0.8);
  color: #fff;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.product-info {
  padding: 20rpx;
}

.product-name {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 32rpx;
  color: #333;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.product-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b81;
  margin-bottom: 8rpx;
}

.product-stock {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.product-stock-out {
  font-size: 24rpx;
  color: #ff6b81;
  margin-bottom: 8rpx;
}

.product-actions {
  display: flex;
  padding: 0 20rpx 20rpx;
  gap: 10rpx;
}

.add-cart-btn {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 28rpx;
  padding: 0;
}

.buy-btn {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 28rpx;
  padding: 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 36rpx;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 28rpx;
}
