<view class='container page-wrapper product-browse-page'>
  <!-- 顶部搜索栏 -->
  <view class='search-container'>
    <view class='search-box'>
      <text class='search-icon'>🔍</text>
      <input class='search-input' placeholder='搜索商品' bindinput='onSearchInput' value='{{searchKeyword}}' />
      <text class='search-clear' wx:if='{{searchKeyword}}' bindtap='onClearSearch'>×</text>
    </view>
  </view>

  <!-- 分类导航 -->
  <scroll-view scroll-x="true" class='category-scroll'>
    <view class='category-item {{activeCategory === "all" ? "active" : ""}}' bindtap='switchCategory' data-category='all'>
      <text>全部</text>
    </view>
    <block wx:for='{{categories}}' wx:key='id'>
      <view class='category-item {{activeCategory === item.id ? "active" : ""}}' bindtap='switchCategory' data-category='{{item.id}}'>
        <text>{{item.name}}</text>
      </view>
    </block>
  </scroll-view>

  <!-- 商品列表 -->
  <view class='product-container'>
    <block wx:for='{{products}}' wx:key='_id'>
      <view class='product-card card card-interactive' bindtap='viewProductDetail' data-id='{{item._id}}'>
        <view class='product-image-wrapper'>
          <image class='product-image' src='{{item.images[0] || ""}}' mode='aspectFill'></image>
          <view class='product-tag' wx:if='{{!item.status}}'>已下架</view>
        </view>
        <view class='product-info'>
          <text class='product-name'>{{item.name}}</text>
          <text class='product-price'>¥{{item.price}}</text>
          <text class='product-stock' wx:if='{{item.stock > 0}}'>库存: {{item.stock}}</text>
          <text class='product-stock-out' wx:else>库存不足</text>
        </view>
        <view class='product-actions'>
          <button class='add-cart-btn btn-secondary' bindtap='addToCart' data-product='{{item}}'>加入购物车</button>
          <button class='buy-btn btn-primary' type='primary' bindtap='buyNow' data-product='{{item}}'>立即购买</button>
        </view>
      </view>
    </block>
  </view>

  <!-- 空状态 -->
  <view class='empty-state' wx:if='{{products.length === 0}}'>
    <text class='empty-icon'>📦</text>
    <text class='empty-text'>暂无商品</text>
    <text class='empty-hint'>商品正在上架中，敬请期待</text>
  </view>
</view>
