/* 页面基础样式 */
.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 表单卡片 */
.form-card {
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 40rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

/* 表单项 */
.form-item {
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.label.required::after {
  content: " *";
  color: #ff4d4f;
}

/* 输入框样式 */
.input, .textarea {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 30rpx;
  background: #fafafa;
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.textarea {
  min-height: 120rpx;
  resize: none;
}

.input:focus, .textarea:focus {
  border-color: #3a7bd5;
  background: white;
  outline: none;
}

.placeholder {
  color: #999;
  font-size: 30rpx;
}

/* 价格输入行 */
.price-row {
  display: flex;
  gap: 30rpx;
}

.price-item {
  flex: 1;
}

.price-input-group {
  display: flex;
  align-items: center;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  background: #fafafa;
  padding-left: 20rpx;
  transition: all 0.3s ease;
}

.price-input-group:focus-within {
  border-color: #3a7bd5;
  background: white;
}

.currency {
  color: #666;
  font-size: 30rpx;
  margin-right: 10rpx;
}

.price-input {
  flex: 1;
  padding: 24rpx 20rpx;
  border: none;
  background: transparent;
  font-size: 30rpx;
}

.price-input:focus {
  outline: none;
}

/* 选择器 */
.picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  background: #fafafa;
  transition: all 0.3s ease;
}

.picker:active {
  background: #f5f5f5;
}

.picker-text {
  font-size: 30rpx;
  color: #333;
}

.picker-text:empty {
  color: #999;
}

.picker-arrow {
  color: #999;
  font-size: 36rpx;
}

/* 单选按钮组 */
.radio-group {
  display: flex;
  gap: 40rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.radio-item text {
  font-size: 30rpx;
  color: #333;
}

/* 字符计数 */
.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 图片上传区域 */
.image-upload-area {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #e0e0e0;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.upload-icon {
  font-size: 60rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
}

.tip-text {
  font-size: 24rpx;
  color: #999;
}

/* 提交按钮 */
.submit-section {
  padding: 0 40rpx 60rpx;
}

.btn-submit {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  background: #3a7bd5;
}

/* Category Modal */
.category-modal {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
}

.modal-confirm {
  color: #3a7bd5;
  font-size: 32rpx;
}

.modal-content {
  flex: 1;
  padding: 20rpx 0;
  overflow-y: auto;
}

.category-list {
  padding: 0 30rpx;
}

.category-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 30rpx;
}

.category-item checkbox {
  margin-right: 20rpx;
  transform: scale(0.9);
}
