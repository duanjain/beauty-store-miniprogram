/* 详情页样式 */
.container {
  background-color: var(--bg-body);
  min-height: 100vh;
  padding-bottom: 0;
}

/* 轮播图 */
.product-swiper {
  width: 100%;
  height: 750rpx; /* 正方形大图 */
  background-color: #fff;
}

.slide-image {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  width: 100%;
  height: 100%;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
}

/* 信息卡片 */
.info-card {
  background-color: #fff;
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.price-wrapper {
  display: flex;
  align-items: baseline;
  color: var(--error-color);
}

.currency {
  font-size: 28rpx;
  font-weight: 500;
  margin-right: 4rpx;
}

.price {
  font-size: 48rpx;
  font-weight: 600;
  font-family: 'DIN', sans-serif;
}

.original-price {
  font-size: 26rpx;
  color: var(--text-tertiary);
  text-decoration: line-through;
  margin-left: 16rpx;
}

.stock-tag {
  font-size: 24rpx;
  color: var(--success-color);
  background-color: rgba(82, 196, 26, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.stock-tag.off {
  color: var(--text-tertiary);
  background-color: #f5f5f5;
}

.product-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-main);
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.product-meta {
  display: flex;
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.product-meta text {
  margin-right: 32rpx;
}

/* 描述卡片 */
.desc-card {
  background-color: #fff;
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 24rpx;
  position: relative;
  padding-left: 16rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 6rpx;
  bottom: 6rpx;
  width: 6rpx;
  background-color: var(--primary-color);
  border-radius: 4rpx;
}

.desc-content {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.info-row {
  display: flex;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.info-row .label {
  color: var(--text-tertiary);
  width: 160rpx;
}

.info-row .value {
  color: var(--text-main);
  flex: 1;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: #fff;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
  box-sizing: border-box;
  /* 垂直布局适配：允许换行 */
  flex-wrap: wrap;
  height: auto;
  
  /* 适配底部安全区域 */
  padding-bottom: 16rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.icon-btn {
  display: flex;
  flex-direction: row; /* 横向排列图标和文字 */
  align-items: center;
  justify-content: flex-start;
  /* 独占一行或作为标题 */
  width: 100%; 
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: var(--text-main);
  padding: 0;
  background-color: transparent;
  line-height: 1.2;
}

.icon {
  font-size: 36rpx;
  margin-right: 8rpx;
  margin-bottom: 0;
}

.action-btn-group {
  /* 按钮组独占下一行，并允许内部换行 */
  width: 100%;
  display: flex;
  flex-wrap: wrap; 
  height: auto;
  justify-content: space-between;
}

.action-btn {
  flex: 0 0 48%; /* 两个按钮一行，留有间隙 */
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  margin: 0;
  margin-bottom: 16rpx; /* 行间距 */
  border-radius: 40rpx;
  border: none;
  height: 80rpx; /* 固定高度 */
  white-space: nowrap;
  padding: 0 10rpx;
}

.action-btn:last-child {
  /* 如果是奇数个按钮，最后一个可能需要占满或保持一半 */
  /* margin-bottom: 0; */
}

.action-btn:first-child {
  margin-left: 0;
}

.edit-btn {
  background-color: var(--primary-color);
  color: #fff;
}

.status-btn {
  background-color: #faad14;
  color: #fff;
}

.status-btn.off-btn {
  background-color: #d9d9d9;
  color: #666;
}

.delete-btn {
  background-color: var(--error-color);
  color: #fff;
}

/* 底部占位符，防止内容被遮挡 */
.bottom-placeholder {
  width: 100%;
  /* 增加高度以适应多行布局: 40(icon) + 16(gap) + 80(btn row 1) + 16(gap) + 80(btn row 2) + padding ≈ 250rpx */
  height: 260rpx; 
  height: calc(260rpx + constant(safe-area-inset-bottom));
  height: calc(260rpx + env(safe-area-inset-bottom));
}
