/* 顶部导航栏样式 */
.top-nav {
  display: flex;
  justify-content: space-between;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  padding: 12rpx;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 16rpx;
  border-radius: 12rpx;
  transition: all 0.3s ease;
  position: relative;
  background: transparent;
}

.nav-item:hover {
  background: rgba(255, 255, 255, 0.1);
  transform: translateY(-2rpx);
}

.nav-item.active {
  background: white;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.nav-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.nav-text {
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

/* 默认（未激活）状态下的文字颜色 */
.nav-item:not(.active) .nav-text {
  color: rgba(255, 255, 255, 0.9);
}

/* 激活状态下的文字颜色 */
.nav-item.active .nav-text {
  color: #667eea;
}

/* 移除旧的下划线样式 */
.nav-item.active::after {
  display: none;
}

/* 头部样式 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  gap: 20rpx;
}

.header button {
  margin: 0;
  width: auto;
}

/* 搜索栏样式 */
.search-bar {
  display: flex;
  margin-bottom: 30rpx;
  padding: 0;
  overflow: hidden;
}

.search-bar input {
  flex: 1;
  height: 92rpx;
  border: none;
  border-radius: 16rpx 0 0 16rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
  margin-right: 0;
  background-color: transparent;
  outline: none;
}

.search-btn {
  font-size: 30rpx;
  font-weight: 600;
  padding: 0 48rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.search-btn:hover {
  transform: translateX(2rpx);
  box-shadow: -2rpx 0 12rpx rgba(102, 126, 234, 0.3);
}

.search-btn:active {
  transform: translateX(0);
  box-shadow: none;
}

/* 商品列表样式 */
.product-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.product-item {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 商品图片样式 */
.product-image {
  width: 100%;
  height: 300rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
}

/* 商品信息样式 */
.product-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.product-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  line-height: 44rpx;
}

.product-price {
  font-size: 36rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.product-stock {
  font-size: 28rpx;
  color: #07c160;
}

.product-stock-out {
  font-size: 28rpx;
  color: #ff4d4f;
}

.product-date {
  font-size: 24rpx;
  color: #999;
}

/* 商品操作按钮样式 */
.product-actions {
  display: flex;
  gap: 15rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e0e0e0;
  flex-wrap: wrap;
}

.product-actions button {
  flex: 1;
  min-width: 150rpx;
  font-size: 28rpx;
  padding: 16rpx;
}

/* 空状态样式 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.empty-hint {
  font-size: 28rpx;
  color: #666;
}


/* 加载更多样式 */
.load-more {
  text-align: center;
  padding: 40rpx 0;
  color: #007aff;
  font-size: 28rpx;
  cursor: pointer;
}

/* 加载动画 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
}

.loading::after {
  content: '';
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #007aff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
