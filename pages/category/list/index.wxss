.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 顶部导航栏样式 */
.top-nav {
  display: flex;
  justify-content: space-between;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  padding: 12rpx;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 16rpx;
  border-radius: 12rpx;
  transition: all 0.3s ease;
  position: relative;
  background: transparent;
}

.nav-item:hover {
  background: rgba(255, 255, 255, 0.1);
  transform: translateY(-2rpx);
}

.nav-item.active {
  background: white;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.nav-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.nav-text {
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

/* 默认（未激活）状态下的文字颜色 */
.nav-item:not(.active) .nav-text {
  color: rgba(255, 255, 255, 0.9);
}

/* 激活状态下的文字颜色 */
.nav-item.active .nav-text {
  color: #667eea;
}

/* 移除旧的下划线样式 */
.nav-item.active::after {
  display: none;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 20rpx;
}
.title {
  font-size: 32rpx;
  font-weight: bold;
}
.category-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 20rpx;
  margin-bottom: 20rpx;
}
.category-name {
  font-size: 30rpx;
  font-weight: 500;
}
.actions button {
  margin-left: 10rpx;
}
.empty {
  text-align: center;
  color: #999;
  margin-top: 50rpx;
}
