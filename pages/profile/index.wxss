/* 个人中心样式 */
.container {
  background-color: var(--bg-body);
}

.user-card {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  border-radius: var(--radius-lg);
  padding: 40rpx 30rpx;
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 129, 0.3);
}

.user-info-row {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  overflow: hidden;
  margin-right: 24rpx;
  background-color: #fff;
}

.user-avatar image {
  width: 100%;
  height: 100%;
}

.user-details {
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.role-tag {
  font-size: 20rpx;
  background-color: rgba(0, 0, 0, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.user-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

.edit-icon {
  font-size: 32rpx;
  opacity: 0.8;
}

.stats-row {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.8;
}

.invite-code-text {
  font-size: 28rpx;
}

/* 菜单卡片 */
.menu-card {
  background-color: #fff;
  border-radius: var(--radius-md);
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.menu-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.menu-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.menu-more {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.order-grid {
  display: flex;
  padding: 30rpx 0;
}

.order-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.order-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.order-item text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 菜单列表 */
.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-color);
  background-color: #fff;
  width: 100%;
  font-weight: normal;
  line-height: normal;
}

.contact-btn {
  margin: 0;
  border-radius: 0;
}

.contact-btn::after {
  border: none;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 40rpx;
  text-align: center;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main);
  text-align: left;
}

.menu-arrow {
  color: #ccc;
  font-size: 24rpx;
}

.logout-section {
  margin-top: 40rpx;
  margin-bottom: 40rpx;
}

.logout-btn {
  background-color: #fff;
  color: var(--error-color);
  font-size: 30rpx;
  border-radius: var(--radius-round);
  box-shadow: var(--shadow-sm);
}

/* 新增：多行菜单文本容器 */
.menu-text-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}

.menu-text-column .menu-text {
  flex: none; /* 在列布局中取消flex:1，由内容决定高度 */
  margin-bottom: 4rpx;
}

.menu-sub-text {
  font-size: 24rpx;
  color: #999;
}
