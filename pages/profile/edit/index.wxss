.container {
  width: 100%;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 30rpx;
  background-color: #fff;
  position: relative;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.header-back {
  position: absolute;
  left: 30rpx;
  font-size: 40rpx;
  color: #333;
}

.content {
  padding: 30rpx;
}

/* 资料项样式 */
.profile-item {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.profile-label {
  display: block;
  font-size: 32rpx;
  color: #666;
  margin-bottom: 20rpx;
}

/* 头像样式 */
.avatar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-container {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.avatar {
  width: 100%;
  height: 100%;
}

.avatar-upload {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(0, 0, 0, 0.6);
  padding: 20rpx 0;
  text-align: center;
}

.upload-text {
  color: #fff;
  font-size: 28rpx;
}

/* 输入框样式 */
.profile-input {
  width: 100%;
  font-size: 34rpx;
  color: #333;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border-bottom: 2rpx solid #eee;
}

.placeholder {
  color: #999;
}

/* 保存按钮样式 */
.save-btn {
  margin-top: 50rpx;
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 34rpx;
  background-color: #e74c3c;
  border-radius: 45rpx;
  color: #fff;
}

.save-btn[disabled] {
  background-color: #ccc;
}

.privacy-tip {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 20rpx;
}
