.container {
  width: 100%;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 30rpx;
  background-color: #fff;
  position: relative;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.header-back {
  position: absolute;
  left: 30rpx;
  font-size: 40rpx;
  color: #333;
}

.content {
  padding: 30rpx;
}

/* 表单样式 */
.form {
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 32rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.form-input {
  width: 100%;
  font-size: 34rpx;
  color: #333;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border-bottom: 2rpx solid #eee;
}

.form-textarea {
  width: 100%;
  font-size: 34rpx;
  color: #333;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #eee;
  min-height: 120rpx;
  line-height: 1.5;
  resize: none;
}

.placeholder {
  color: #999;
}

/* 地图选择样式 */
.map-item .form-input {
  border-bottom: none;
}

.map-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #eee;
}

.map-placeholder {
  font-size: 34rpx;
  color: #999;
  flex: 1;
}

.map-address {
  font-size: 34rpx;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.privacy-tip {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 20rpx;
  padding-bottom: 30rpx;
}

.map-arrow {
  font-size: 34rpx;
  color: #999;
  margin-left: 20rpx;
}

/* 复选框样式 */
.checkbox-item {
  display: flex;
  align-items: center;
  margin-top: 40rpx;
}

.form-checkbox {
  transform: scale(1.5);
  margin-right: 20rpx;
}

.checkbox-label {
  font-size: 32rpx;
  color: #666;
}

/* 保存按钮样式 */
.save-btn {
  margin-top: 50rpx;
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 34rpx;
}

.save-btn[disabled] {
  background-color: #ccc;
}
