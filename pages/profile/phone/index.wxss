.container {
  width: 100%;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 30rpx;
  background-color: #fff;
  position: relative;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.header-back {
  position: absolute;
  left: 30rpx;
  font-size: 40rpx;
  color: #333;
}

.content {
  padding: 30rpx;
}

.form-item {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.form-label {
  display: block;
  font-size: 32rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.form-input {
  width: 100%;
  font-size: 34rpx;
  color: #333;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border-bottom: 2rpx solid #eee;
}

.placeholder {
  color: #999;
}

.save-btn {
  margin-top: 50rpx;
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 34rpx;
  background-color: #e74c3c;
  border-radius: 45rpx;
  color: #fff;
}

.save-btn[disabled] {
  background-color: #ccc;
}
